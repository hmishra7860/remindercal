# ---- Database ----
POSTGRES_USER=remindercal
POSTGRES_PASSWORD=change-me
POSTGRES_DB=remindercal

# ---- Security ----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Also used to encrypt stored SMTP passwords - changing it invalidates saved SMTP passwords.
SECRET_KEY=change-me-to-a-long-random-string

# ---- URLs ----
# Public URL users reach the app on (used in email buttons and the calendar feed URL)
PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080

# ---- Behaviour ----
SNOOZE_MINUTES=60
SCHEDULER_ENABLED=true
# Allow SMTP hosts / webhooks on private networks (e.g. MailHog). Keep false in production.
ALLOW_PRIVATE_TARGETS=false

# ---- Web Push (optional): run `python scripts/generate_vapid.py` ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Forward-to-create (optional) ----
INBOUND_DOMAIN=remindercal.com
# Enables POST /api/inbound/email (send header X-Inbound-Secret). Leave empty to disable.
INBOUND_WEBHOOK_SECRET=
# Or poll a catch-all mailbox that receives save+<token>@your-domain
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_POLL_SECONDS=120

# ---- Monitoring ----
GRAFANA_PASSWORD=admin
